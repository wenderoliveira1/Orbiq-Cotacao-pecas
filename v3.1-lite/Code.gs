const APP={VERSION:'3.1.0',NAME:'Orbiq',SHEETS:{BUDGETS:'Orcamentos',ITEMS:'Itens_Orcamento',SUPPLIERS:'Fornecedores',QUOTES:'Cotacoes',SETTINGS:'Configuracoes',LABOR:'Mao_de_Obra',CUSTOM:'Servicos_Personalizados'},QUOTE_CATEGORIES:['Mecânica','Chassi - Paralelo/Original','Chassi - Ferro Velho','Pneus','Vidros','Óleos e Lubrificantes','Outros'],STATUSES:['Aguardando avaliação','Aguardando cotação','Em orçamento','Aprovado','Reprovado','Aguardando peças','Em execução','Finalizado']};
const H={budgets:['ID','Data/Hora','Montador','Cliente','Telefone','Placa','Veículo','Chassi/VIN','KM','Serviços solicitados','Observações','Urgência','Status','Necessita cotação','Categorias cotadas','Valor final','Criado por','Atualizado em','Mão de obra total'],items:['ID Item','ID Orçamento','Categoria','Item/Peça','Quantidade','Unidade','Marca/Especificação','Observações','Status compra','Fornecedor escolhido','Valor escolhido','Criado em','Atualizado em','Lado','Posição','Origem Serviço'],suppliers:['ID Fornecedor','Categoria','Fornecedor','WhatsApp','Ativo','Observações','Criado em','Atualizado em'],quotes:['ID Cotação-Fornecedor','ID Grupo Cotação','ID Orçamento','Categoria','ID Fornecedor','Fornecedor','WhatsApp','Mensagem','Status','Aberto em','Marca/Opção','Valor','Prazo/Entrega','Observação da resposta','Vencedor','Atualizado em'],settings:['Chave','Valor','Descrição'],labor:['ID','Serviço','Valor','Ativo','Criado em','Atualizado em'],custom:['ID Serviço','Categoria','Serviço','Criado em','Atualizado em']};
function doGet(){setupApp_();return HtmlService.createTemplateFromFile('Index').evaluate().setTitle('Orbiq | Gestão de Orçamentos').addMetaTag('viewport','width=device-width, initial-scale=1, viewport-fit=cover')}
function setupApp(){setupApp_();return 'Orbiq V3.1 Lite configurado.'}
function setupApp_(){const ss=SpreadsheetApp.getActiveSpreadsheet();ensure_(ss,APP.SHEETS.BUDGETS,H.budgets);ensure_(ss,APP.SHEETS.ITEMS,H.items);ensure_(ss,APP.SHEETS.SUPPLIERS,H.suppliers);ensure_(ss,APP.SHEETS.QUOTES,H.quotes);ensure_(ss,APP.SHEETS.SETTINGS,H.settings);prepareLabor_(ss);ensure_(ss,APP.SHEETS.LABOR,H.labor);ensure_(ss,APP.SHEETS.CUSTOM,H.custom);seedSettings_()}
function ensure_(ss,name,headers){let s=ss.getSheetByName(name)||ss.insertSheet(name);if(!s.getLastRow())s.getRange(1,1,1,headers.length).setValues([headers]);else{const cur=s.getRange(1,1,1,Math.max(s.getLastColumn(),headers.length)).getDisplayValues()[0];headers.forEach((h,i)=>{if(!cur[i])s.getRange(1,i+1).setValue(h)})}s.setFrozenRows(1);s.getRange(1,1,1,headers.length).setFontWeight('bold').setBackground('#0f172a').setFontColor('#fff');return s}
function prepareLabor_(ss){const s=ss.getSheetByName(APP.SHEETS.LABOR);if(!s||!s.getLastRow())return;const row=s.getRange(1,1,1,Math.max(5,s.getLastColumn())).getDisplayValues()[0];if(row[0]==='ID Serviço'&&row[1]==='Categoria'&&row[2]==='Serviço'){s.clear();s.getRange(1,1,1,H.labor.length).setValues([H.labor])}}
function seedSettings_(){const s=SpreadsheetApp.getActiveSpreadsheet().getSheetByName(APP.SHEETS.SETTINGS),m={};if(s.getLastRow()>1)s.getRange(2,1,s.getLastRow()-1,3).getDisplayValues().forEach(r=>m[r[0]]=1);if(!m.GESTOR_NOME)s.appendRow(['GESTOR_NOME','','Nome do gestor']);if(!m.GESTOR_WHATSAPP)s.appendRow(['GESTOR_WHATSAPP','','WhatsApp do gestor'])}
function getInitialData(){setupApp_();return{version:APP.VERSION,quoteCategories:APP.QUOTE_CATEGORIES,statuses:APP.STATUSES,settings:getSettings_(),dashboard:getDashboard_(),rankings:getRankings_(),recentBudgets:listBudgets_(30),quoteGroups:listQuoteGroups_(30),suppliers:listSuppliers_(),labor:listLabor_(),customServices:listCustomServices_()}}
function saveBudget(payload){setupApp_();const d=normBudget_(payload);validateBudget_(d);const lock=LockService.getScriptLock();lock.waitLock(30000);try{const ss=SpreadsheetApp.getActiveSpreadsheet(),bs=ss.getSheetByName(APP.SHEETS.BUDGETS),is=ss.getSheetByName(APP.SHEETS.ITEMS),qs=ss.getSheetByName(APP.SHEETS.QUOTES),now=new Date(),budgetId=id_('ORB'),lm=laborMap_();let laborTotal=0;d.services.forEach(x=>{x.laborValue=laborFor_(x.description,lm);laborTotal+=x.laborValue});const servicesText=d.services.map((x,i)=>`${i+1}. [${x.category}] ${x.description}${x.side?' — Lado: '+x.side:''}${x.position?' — Posição: '+x.position:''} — M.O.: ${x.laborValue?money_(x.laborValue):'não cadastrada'}`).join('\n');const purchaseItems=d.services.filter(x=>x.buyPart&&x.partDescription).map(x=>({category:x.partCategory||'Mecânica',description:x.partDescription,quantity:x.partQty||'1',unit:x.partUnit||'un.',specification:x.partSpecification||'',notes:'',side:x.side||'',position:x.position||'',originService:x.description})).concat(d.extraItems);const cats=unique_(purchaseItems.map(x=>x.category)),needs=!!purchaseItems.length,status=needs?'Aguardando cotação':'Aguardando avaliação';bs.appendRow([safe_(budgetId),now,safe_(d.assembler),safe_(d.customerName),safe_(d.phone),safe_(d.plate.toUpperCase()),safe_(d.vehicle),'',safe_(d.mileage),safe_(servicesText),safe_(d.notes),safe_(d.urgency),status,needs?'Sim':'Não',safe_(cats.join(' | ')),'',safe_(Session.getActiveUser().getEmail()||'Acesso via link'),now,laborTotal]);if(purchaseItems.length){const rows=purchaseItems.map(x=>[id_('ITEM'),budgetId,x.category,safe_(x.description),safe_(x.quantity),safe_(x.unit),safe_(x.specification),safe_(x.notes),'A cotar','','',now,now,safe_(x.side),safe_(x.position),safe_(x.originService)]);is.getRange(is.getLastRow()+1,1,rows.length,H.items.length).setValues(rows)}const sm=supplierMap_(),groups=[];cats.forEach((cat,idx)=>{const groupItems=purchaseItems.filter(x=>x.category===cat),suppliers=(sm[cat]||[]).filter(x=>x.active),groupId=`COT-${budgetId.replace('ORB-','')}-${String(idx+1).padStart(2,'0')}`,message=supplierMessage_(budgetId,d,cat,groupItems),sq=[];if(suppliers.length)suppliers.forEach(s=>{const qid=id_('QF');qs.appendRow([qid,groupId,budgetId,cat,s.id,safe_(s.name),s.phone,safe_(message),'Pendente','','','','','','Não',now]);sq.push({quoteId:qid,supplierName:s.name,phone:s.phone,whatsappUrl:whatsapp_(s.phone,message),status:'Pendente'})});else qs.appendRow([id_('QF'),groupId,budgetId,cat,'','SEM FORNECEDOR CADASTRADO','',safe_(message),'Sem fornecedor','','','','','','Não',now]);groups.push({groupId,category:cat,suppliers:sq,missingSuppliers:!suppliers.length})});const settings=getSettings_(),mm=managerMessage_(budgetId,d,servicesText,purchaseItems,groups,laborTotal);return{success:true,budgetId,status,laborTotal,managerConfigured:!!settings.managerWhatsapp,managerWhatsappUrl:settings.managerWhatsapp?whatsapp_(settings.managerWhatsapp,mm):'',quoteGroups:groups}}finally{lock.releaseLock()}}
function saveCustomService(category,description){setupApp_();category=clean_(category);description=clean_(description);if(!category||!description)throw new Error('Informe categoria e serviço.');const existing=listCustomServices_().find(x=>norm_(x.category+'|'+x.description)===norm_(category+'|'+description));if(existing)return{success:true,alreadyExists:true,service:existing};const service={id:id_('SRV'),category,description},now=new Date();SpreadsheetApp.getActiveSpreadsheet().getSheetByName(APP.SHEETS.CUSTOM).appendRow([service.id,safe_(category),safe_(description),now,now]);return{success:true,alreadyExists:false,service}}
function addLabor(payload){setupApp_();const service=clean_(payload&&payload.service),value=currency_(payload&&payload.value);if(!service)throw new Error('Informe o serviço de mão de obra.');if(listLabor_().some(x=>norm_(x.service)===norm_(service)))throw new Error('Este serviço já está cadastrado.');const id=id_('MO'),now=new Date();SpreadsheetApp.getActiveSpreadsheet().getSheetByName(APP.SHEETS.LABOR).appendRow([id,safe_(service),value,'Sim',now,now]);return{success:true,id}}
function updateLabor(payload){const loc=findRow_(APP.SHEETS.LABOR,payload.id,1);if(!loc)throw new Error('Mão de obra não encontrada.');const service=clean_(payload.service),value=currency_(payload.value);if(!service)throw new Error('Informe o serviço.');loc.sheet.getRange(loc.row,2,1,2).setValues([[safe_(service),value]]);loc.sheet.getRange(loc.row,6).setValue(new Date());return{success:true}}
function removeLabor(id){const loc=findRow_(APP.SHEETS.LABOR,id,1);if(!loc)throw new Error('Mão de obra não encontrada.');loc.sheet.deleteRow(loc.row);return{success:true}}
function markQuoteOpened(id){const l=findRow_(APP.SHEETS.QUOTES,id,1);if(!l)throw new Error('Cotação não encontrada.');if(String(l.sheet.getRange(l.row,9).getValue())==='Pendente')l.sheet.getRange(l.row,9).setValue('WhatsApp aberto');l.sheet.getRange(l.row,10).setValue(new Date());l.sheet.getRange(l.row,16).setValue(new Date());return{success:true}}
function saveQuoteResponse(p){const l=findRow_(APP.SHEETS.QUOTES,p.quoteId,1);if(!l)throw new Error('Cotação não encontrada.');l.sheet.getRange(l.row,9).setValue('Respondido');l.sheet.getRange(l.row,11,1,4).setValues([[safe_(p.brand),safe_(p.value),safe_(p.delivery),safe_(p.notes)]]);l.sheet.getRange(l.row,16).setValue(new Date());return{success:true}}
function chooseSupplier(id){const l=findRow_(APP.SHEETS.QUOTES,id,1);if(!l)throw new Error('Cotação não encontrada.');const selected=l.sheet.getRange(l.row,1,1,H.quotes.length).getDisplayValues()[0];if(!selected[5]||selected[5]==='SEM FORNECEDOR CADASTRADO')throw new Error('Fornecedor inválido.');const rows=l.sheet.getRange(2,1,l.sheet.getLastRow()-1,H.quotes.length).getDisplayValues();rows.forEach((r,i)=>{if(r[1]!==selected[1])return;const rr=i+2,chosen=r[0]===id;l.sheet.getRange(rr,9).setValue(chosen?'Escolhido':(r[8]==='Sem fornecedor'?'Sem fornecedor':'Não escolhido'));l.sheet.getRange(rr,15).setValue(chosen?'Sim':'Não');l.sheet.getRange(rr,16).setValue(new Date())});updateBudgetStatus_(selected[2],'Em orçamento');return{success:true,supplierName:selected[5]}}
function updateBudgetStatus(id,status){if(APP.STATUSES.indexOf(status)<0)throw new Error('Status inválido.');updateBudgetStatus_(id,status);return{success:true}}
function updateBudgetStatus_(id,status){const l=findRow_(APP.SHEETS.BUDGETS,id,1);if(!l)throw new Error('Orçamento não encontrado.');l.sheet.getRange(l.row,13).setValue(status);l.sheet.getRange(l.row,18).setValue(new Date())}
function saveSettings(p){const phone=phone_(p&&p.managerWhatsapp);if(phone&&!/^55\d{10,11}$/.test(phone))throw new Error('WhatsApp do gestor inválido.');setSetting_('GESTOR_NOME',clean_(p&&p.managerName));setSetting_('GESTOR_WHATSAPP',phone);return{success:true,settings:getSettings_()}}
function getSettings_(){const s=SpreadsheetApp.getActiveSpreadsheet().getSheetByName(APP.SHEETS.SETTINGS),m={};if(s.getLastRow()>1)s.getRange(2,1,s.getLastRow()-1,3).getDisplayValues().forEach(r=>m[r[0]]=r[1]);return{managerName:m.GESTOR_NOME||'',managerWhatsapp:m.GESTOR_WHATSAPP||''}}
function setSetting_(key,value){const s=SpreadsheetApp.getActiveSpreadsheet().getSheetByName(APP.SHEETS.SETTINGS);if(s.getLastRow()>1){const rows=s.getRange(2,1,s.getLastRow()-1,3).getDisplayValues();for(let i=0;i<rows.length;i++)if(rows[i][0]===key){s.getRange(i+2,2).setValue(safe_(value));return}}s.appendRow([key,safe_(value),''])}
function saveSupplier(p){p=p||{};const name=clean_(p.name),category=clean_(p.category),phone=phone_(p.phone);if(!name||!phone)throw new Error('Informe fornecedor e WhatsApp.');if(APP.QUOTE_CATEGORIES.indexOf(category)<0)throw new Error('Categoria inválida.');if(!/^55\d{10,11}$/.test(phone))throw new Error('WhatsApp inválido.');const s=SpreadsheetApp.getActiveSpreadsheet().getSheetByName(APP.SHEETS.SUPPLIERS),now=new Date();if(p.id){const l=findRow_(APP.SHEETS.SUPPLIERS,p.id,1);if(!l)throw new Error('Fornecedor não encontrado.');s.getRange(l.row,2,1,5).setValues([[category,safe_(name),phone,'Sim',safe_(p.notes)]]);s.getRange(l.row,8).setValue(now);return{success:true,id:p.id}}const id=id_('FOR');s.appendRow([id,category,safe_(name),phone,'Sim',safe_(p.notes),now,now]);return{success:true,id}}
function toggleSupplier(id,active){const l=findRow_(APP.SHEETS.SUPPLIERS,id,1);if(!l)throw new Error('Fornecedor não encontrado.');l.sheet.getRange(l.row,5).setValue(active?'Sim':'Não');l.sheet.getRange(l.row,8).setValue(new Date());return{success:true}}
function listLabor_(){const s=SpreadsheetApp.getActiveSpreadsheet().getSheetByName(APP.SHEETS.LABOR);if(s.getLastRow()<=1)return[];return s.getRange(2,1,s.getLastRow()-1,H.labor.length).getValues().map(r=>({id:String(r[0]),service:String(r[1]||''),value:Number(r[2])||0,active:String(r[3]||'Sim')!=='Não'})).filter(x=>x.service&&x.active).sort((a,b)=>a.service.localeCompare(b.service,'pt-BR'))}
function laborMap_(){const m={};listLabor_().forEach(x=>m[norm_(x.service)]=x.value);return m}
function laborFor_(service,map){const exact=map[norm_(service)];if(exact!=null)return exact;const generic=clean_(service).split(' ')[0];return map[norm_(generic)]!=null?map[norm_(generic)]:0}
function listCustomServices_(){const s=SpreadsheetApp.getActiveSpreadsheet().getSheetByName(APP.SHEETS.CUSTOM);if(s.getLastRow()<=1)return[];return s.getRange(2,1,s.getLastRow()-1,H.custom.length).getDisplayValues().map(r=>({id:r[0],category:r[1],description:r[2]})).filter(x=>x.category&&x.description)}
function listBudgets_(limit){const s=SpreadsheetApp.getActiveSpreadsheet().getSheetByName(APP.SHEETS.BUDGETS);if(s.getLastRow()<=1)return[];const count=Math.min(limit||30,s.getLastRow()-1),start=s.getLastRow()-count+1;return s.getRange(start,1,count,H.budgets.length).getDisplayValues().reverse().map(r=>({id:r[0],date:r[1],assembler:r[2],customer:r[3],plate:r[5],vehicle:r[6],services:r[9],urgency:r[11],status:r[12],laborTotal:r[18]}))}
function listSuppliers_(){const s=SpreadsheetApp.getActiveSpreadsheet().getSheetByName(APP.SHEETS.SUPPLIERS);if(s.getLastRow()<=1)return[];return s.getRange(2,1,s.getLastRow()-1,H.suppliers.length).getDisplayValues().map(r=>({id:r[0],category:r[1],name:r[2],phone:r[3],active:r[4]==='Sim',notes:r[5]})).sort((a,b)=>(a.category+a.name).localeCompare(b.category+b.name,'pt-BR'))}
function listQuoteGroups_(limit){const s=SpreadsheetApp.getActiveSpreadsheet().getSheetByName(APP.SHEETS.QUOTES);if(s.getLastRow()<=1)return[];const rows=s.getRange(2,1,s.getLastRow()-1,H.quotes.length).getDisplayValues(),bm={};listBudgets_(300).forEach(b=>bm[b.id]=b);const groups={},order=[];rows.slice().reverse().forEach(r=>{if(!groups[r[1]]){const b=bm[r[2]]||{};groups[r[1]]={groupId:r[1],budgetId:r[2],category:r[3],plate:b.plate||'',vehicle:b.vehicle||'',suppliers:[]};order.push(r[1])}if(r[5]!=='SEM FORNECEDOR CADASTRADO')groups[r[1]].suppliers.push({quoteId:r[0],supplierName:r[5],phone:r[6],status:r[8],brand:r[10],value:r[11],delivery:r[12],notes:r[13],winner:r[14]==='Sim',whatsappUrl:r[6]?whatsapp_(r[6],r[7]):''})});return order.slice(0,limit||30).map(id=>{groups[id].suppliers.reverse();return groups[id]})}
function getDashboard_(){const ss=SpreadsheetApp.getActiveSpreadsheet(),b=ss.getSheetByName(APP.SHEETS.BUDGETS),q=ss.getSheetByName(APP.SHEETS.QUOTES),s=ss.getSheetByName(APP.SHEETS.SUPPLIERS),today=Utilities.formatDate(new Date(),Session.getScriptTimeZone(),'dd/MM/yyyy');let budgetsToday=0,awaitingQuotes=0,answeredQuotes=0,activeSuppliers=0;if(b.getLastRow()>1)b.getRange(2,1,b.getLastRow()-1,H.budgets.length).getDisplayValues().forEach(r=>{if(String(r[1]).indexOf(today)===0)budgetsToday++;if(r[12]==='Aguardando cotação')awaitingQuotes++});if(q.getLastRow()>1)q.getRange(2,1,q.getLastRow()-1,H.quotes.length).getDisplayValues().forEach(r=>{if(r[8]==='Respondido')answeredQuotes++});if(s.getLastRow()>1)s.getRange(2,1,s.getLastRow()-1,H.suppliers.length).getDisplayValues().forEach(r=>{if(r[4]==='Sim')activeSuppliers++});return{budgetsToday,awaitingQuotes,answeredQuotes,activeSuppliers}}
function getRankings_(){const s=SpreadsheetApp.getActiveSpreadsheet().getSheetByName(APP.SHEETS.BUDGETS);if(s.getLastRow()<=1)return{week:[],month:[]};const rows=s.getRange(2,1,s.getLastRow()-1,H.budgets.length).getValues(),now=new Date(),sw=new Date(now.getFullYear(),now.getMonth(),now.getDate()),sm=new Date(now.getFullYear(),now.getMonth(),1),week={},month={};sw.setDate(sw.getDate()+(sw.getDay()===0?-6:1-sw.getDay()));sw.setHours(0,0,0,0);rows.forEach(r=>{const d=r[1] instanceof Date?r[1]:new Date(r[1]),name=clean_(r[2]);if(!name||isNaN(d.getTime()))return;if(d>=sw)week[name]=(week[name]||0)+1;if(d>=sm)month[name]=(month[name]||0)+1});return{week:ranking_(week),month:ranking_(month)}}
function ranking_(m){return Object.keys(m).map(name=>({name,count:m[name]})).sort((a,b)=>b.count-a.count||a.name.localeCompare(b.name,'pt-BR'))}
function managerMessage_(budgetId,d,servicesText,items,groups,laborTotal){const lines=['🔧 *NOVO ORÇAMENTO - ORBIQ*','📋 Protocolo: *'+budgetId+'*','','👨‍🔧 Montador: '+d.assembler,'👤 Cliente: '+d.customerName,'📱 Telefone: '+d.phone,'🚘 Placa: '+d.plate.toUpperCase(),'🚗 Veículo: '+d.vehicle,d.mileage?'🛣️ KM: '+d.mileage:'','⚠️ Prioridade: '+d.urgency,'','*Serviços:*',servicesText,'','💰 *Mão de obra:* '+(laborTotal?money_(laborTotal):'não cadastrada')];if(items.length){lines.push('','*Peças para cotação:*');items.forEach((x,i)=>lines.push(`${i+1}. [${x.category}] ${x.description} — ${x.quantity||1} ${x.unit||'un.'}${x.side?' — '+x.side:''}${x.position?' — '+x.position:''}`))}const gs=groups.filter(g=>g.suppliers&&g.suppliers.length);if(gs.length){lines.push('','*Fornecedores encontrados:*');gs.forEach(g=>{lines.push('📦 *'+g.category+'*');g.suppliers.forEach(s=>lines.push('• '+s.supplierName+' — +'+s.phone))})}if(d.notes)lines.push('','📝 '+d.notes);return lines.filter(x=>x!==undefined).join('\n')}
function supplierMessage_(budgetId,d,category,items){const lines=['🧾 *COTAÇÃO - ORBIQ*','Protocolo: *'+budgetId+'*','Categoria: *'+category+'*','','🚗 '+d.vehicle,'🚘 '+d.plate.toUpperCase(),'','*Itens:*'];items.forEach((x,i)=>lines.push(`${i+1}. ${x.description} — ${x.quantity||1} ${x.unit||'un.'}${x.side?'\n   Lado: '+x.side:''}${x.position?'\n   Posição: '+x.position:''}${x.specification?'\n   Especificação: '+x.specification:''}`));lines.push('','Informe marca, valor, disponibilidade e prazo.','Obrigado! — Orbiq');return lines.join('\n')}
function normBudget_(p){p=p||{};return{assembler:clean_(p.assembler),customerName:clean_(p.customerName),phone:clean_(p.phone),plate:clean_(p.plate),vehicle:clean_(p.vehicle),mileage:clean_(p.mileage),urgency:clean_(p.urgency||'Normal'),notes:clean_(p.notes),services:Array.isArray(p.services)?p.services.map(x=>({category:clean_(x.category),description:clean_(x.description),side:clean_(x.side),position:clean_(x.position),buyPart:!!x.buyPart,partDescription:clean_(x.partDescription),partCategory:clean_(x.partCategory||'Mecânica'),partQty:clean_(x.partQty||'1'),partUnit:clean_(x.partUnit||'un.'),partSpecification:clean_(x.partSpecification)})).filter(x=>x.description):[],extraItems:Array.isArray(p.extraItems)?p.extraItems.map(x=>({category:clean_(x.category||'Outros'),description:clean_(x.description),quantity:clean_(x.quantity||'1'),unit:clean_(x.unit||'un.'),specification:clean_(x.specification),notes:clean_(x.notes),side:clean_(x.side),position:clean_(x.position),originService:'Peça adicional'})).filter(x=>x.description):[]}}
function validateBudget_(d){if(!d.assembler)throw new Error('Informe o montador.');if(!d.customerName)throw new Error('Informe o cliente.');if(!d.phone)throw new Error('Informe o telefone.');if(!d.plate)throw new Error('Informe a placa.');if(!d.vehicle)throw new Error('Informe o veículo.');if(!d.services.length)throw new Error('Selecione pelo menos um serviço.')}
function supplierMap_(){const m={};listSuppliers_().forEach(s=>(m[s.category]||(m[s.category]=[])).push(s));return m}
function findRow_(name,id,col){const s=SpreadsheetApp.getActiveSpreadsheet().getSheetByName(name);if(!s||s.getLastRow()<=1)return null;const v=s.getRange(2,col,s.getLastRow()-1,1).getDisplayValues();for(let i=0;i<v.length;i++)if(String(v[i][0])===String(id))return{sheet:s,row:i+2};return null}
function id_(prefix){return prefix+'-'+Utilities.formatDate(new Date(),Session.getScriptTimeZone(),'yyyyMMdd')+'-'+Utilities.getUuid().replace(/-/g,'').slice(0,6).toUpperCase()}
function clean_(v){return String(v==null?'':v).trim()}
function safe_(v){const t=clean_(v);return /^[=+\-@]/.test(t)?"'"+t:t}
function phone_(v){return String(v==null?'':v).replace(/\D/g,'')}
function norm_(v){return clean_(v).toLocaleLowerCase('pt-BR').normalize('NFD').replace(/[\u0300-\u036f]/g,'')}
function unique_(a){return a.filter((x,i)=>x&&a.indexOf(x)===i)}
function whatsapp_(p,m){return'https://wa.me/'+phone_(p)+'?text='+encodeURIComponent(m||'')}
function money_(v){return'R$ '+Number(v||0).toFixed(2).replace('.',',')}
function currency_(v){if(typeof v==='number')return v;let t=clean_(v).replace(/R\$/gi,'').replace(/\s/g,'');if(!t)return 0;if(t.indexOf(',')>=0)t=t.replace(/\./g,'').replace(',','.');return Number(t)||0}
